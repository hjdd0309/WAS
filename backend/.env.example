OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=verse

# 프론트 배포 origin (CORS 허용). 여러 개면 콤마로 구분. 배포 시 필수.
FRONTEND_ORIGIN=http://localhost:5173

# 프론트가 요청 헤더 x-app-secret 으로 함께 보내는 공유 시크릿.
# URL만 아는 봇/스캐너의 무차별 호출을 막는 최소한의 장치 (완전한 인증은 아님).
# 배포 시 반드시 설정 권장 — 비워두면 로컬 개발처럼 검증을 건너뜀.
APP_SHARED_SECRET=

PORT=3000
