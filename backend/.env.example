OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=verse

# 프론트 배포 origin (CORS 허용). 여러 개면 콤마로 구분. 배포 시 필수.
FRONTEND_ORIGIN=http://localhost:5173

# 프론트가 요청 헤더 x-app-secret 으로 함께 보내는 공유 시크릿.
# URL만 아는 봇/스캐너의 무차별 호출을 막는 최소한의 장치 (완전한 인증은 아님).
# 배포 시 반드시 설정 권장 — 비워두면 로컬 개발처럼 검증을 건너뜀.
APP_SHARED_SECRET=

PORT=3000

# 사용자별 프로필(관심사/계획/루틴/이전 통화 요약/푸시 구독)을 저장하는 Redis.
# Vercel 대시보드 → Storage → Marketplace에서 "Redis"(Upstash) 통합을 연결하면
# 자동으로 주입된다(신규 이름 UPSTASH_REDIS_REST_URL/TOKEN도 지원). 비어있으면
# in-memory Map으로 폴백해서 로컬 개발은 그냥 동작하지만, 서버리스 인스턴스마다
# 따로 살고 재시작하면 날아가므로 배포 전에는 반드시 연결해야 한다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 알림 문구(친구가 보낸 것 같은 짧은 문자) 생성에 쓰는 채팅 모델. Realtime 음성
# 모델과 무관하게 텍스트 한 줄만 필요해서 훨씬 저렴한 모델을 쓴다.
NOTIFICATION_TEXT_MODEL=gpt-4o-mini

# 실제 PWA 웹푸시(Web Push)에 필요한 VAPID 키 쌍. `npx web-push generate-vapid-keys`
# (backend/ 안에서 web-push 설치 후 실행)로 생성 — 순수 로컬 연산이라 외부 호출 없음.
# VITE_VAPID_PUBLIC_KEY(frontend/.env.example)에는 반드시 같은 공개키를 넣어야 한다.
# 비어있으면 /api/push/send가 501을 반환하고, 프론트는 로컬 알림으로 폴백한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
