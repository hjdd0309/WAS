# backend/ 는 별도로 배포되므로(Vercel 등) 실제 통화 기능을 쓰려면 반드시
# 배포된 백엔드 URL로 채워야 한다. 로컬에서 backend를 `npm run dev`로
# 띄웠다면 기본값(http://localhost:3000)을 그대로 써도 된다.
VITE_API_BASE_URL=http://localhost:3000

# backend의 APP_SHARED_SECRET을 설정했다면 동일한 값을 여기에도 넣어야
# 통화 요청이 401로 거부되지 않는다. 프론트에 심어지는 값이라 완전한
# 비밀은 아니며(빌드에 노출됨), 봇 스캐너를 걸러내는 최소한의 장치일 뿐이다.
VITE_APP_SHARED_SECRET=

# 서버 Push 구독에 필요한 VAPID 공개키. backend의 VAPID_PUBLIC_KEY와
# 반드시 같은 키 쌍이어야 한다(backend/.env.example 참고, `npx web-push
# generate-vapid-keys`로 생성). 비어있으면 알림 허용 시 구독을 시도하지 않고
# 조용히 로컬 알림 폴백만 쓴다(lib/push.js).
VITE_VAPID_PUBLIC_KEY=
